# Port for the Node.js Express server
PORT=5000

# MongoDB Connection URI (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/mylocal_cep
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mylocal_cep?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mylocal_cep

# JWT Secret for Admin Session Tokens
JWT_SECRET=mylocal_services_mumbai_cep_jwt_secret_key_2026

# Environment
NODE_ENV=development
